# TRR architecture refactor profile
# Local/test runtime only. All hosted mutation and remote worker paths are disabled.
APP_ENV=test
WORKSPACE_RUNTIME_CAPACITY_PROFILE=architecture_refactor
WORKSPACE_ARCHITECTURE_DB_TARGET=loopback-only
TRR_DB_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
WORKSPACE_TRR_DB_LANE=direct
TRR_DB_TRANSACTION_FLIGHT_TEST=0
WORKSPACE_OPEN_BROWSER=0
WORKSPACE_BACKEND_AUTO_RESTART=0
WORKSPACE_TRR_JOB_PLANE_MODE=local
WORKSPACE_TRR_LONG_JOB_ENFORCE_REMOTE=0
WORKSPACE_TRR_REMOTE_EXECUTOR=modal
WORKSPACE_TRR_MODAL_ENABLED=0
WORKSPACE_TRR_REMOTE_WORKERS_ENABLED=0
WORKSPACE_TRR_REMOTE_SOCIAL_WORKERS=0
WORKSPACE_TRR_REMOTE_SOCIAL_DISPATCH_LIMIT=4
WORKSPACE_TRR_MODAL_SOCIAL_JOB_CONCURRENCY_LIMIT=4
WORKSPACE_TRR_REMOTE_SOCIAL_POSTS=1
WORKSPACE_TRR_REMOTE_SOCIAL_COMMENTS=1
WORKSPACE_TRR_REMOTE_SOCIAL_MEDIA_MIRROR=1
WORKSPACE_TRR_REMOTE_SOCIAL_COMMENT_MEDIA_MIRROR=1
WORKSPACE_SOCIAL_WORKER_ENABLED=0
WORKSPACE_RUNTIME_RECONCILE_ENABLED=0
WORKSPACE_RUNTIME_DB_AUTO_APPLY_ENABLED=0
WORKSPACE_RUNTIME_DB_MAX_AUTO_APPLY=0
WORKSPACE_RUNTIME_MODAL_AUTO_DEPLOY=0
WORKSPACE_RUNTIME_EXTERNAL_VERIFY_ENABLED=0
WORKSPACE_RUNTIME_RENDER_VERIFY_ONLY=1
WORKSPACE_RUNTIME_DECODO_VERIFY_ONLY=1
TRR_BACKEND_RELOAD=0
TRR_BACKEND_WORKERS=1
TRR_BACKEND_REQUIRE_REDIS_FOR_MULTI_WORKER=1
