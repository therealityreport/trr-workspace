{
  "schemaVersion": 2,
  "project": {
    "name": "TRR",
    "detail": "User, Admin, and backend API routes."
  },
  "services": [
    {
      "id": "trr-dev-portless",
      "name": "trr",
      "label": "TRR Dev",
      "detail": "TRR app, admin, and API through one workspace launcher.",
      "launcher": {
        "kind": "make-target",
        "target": "dev"
      },
      "routing": "self-managed",
      "runModes": [
        {
          "id": "dev-hybrid",
          "label": "TRR",
          "detail": "Normal TRR workspace.",
          "launcher": {
            "kind": "make-target",
            "target": "dev"
          }
        }
      ],
      "stop": {
        "kind": "make-target",
        "target": "stop"
      },
      "repair": {
        "kind": "make-target",
        "target": "portless-repair"
      },
      "routes": [
        {
          "id": "admin.trr",
          "label": "Admin",
          "url": "https://admin.trr.localhost",
          "expectedMode": "wildcard"
        },
        {
          "id": "trr",
          "label": "User",
          "url": "https://trr.localhost",
          "expectedMode": "managed"
        },
        {
          "id": "api.trr",
          "label": "Backend",
          "url": "https://api.trr.localhost/health/live",
          "expectedMode": "managed",
          "health": {
            "path": "/health/live",
            "status": 200
          }
        }
      ]
    }
  ]
}
